// The feedback Worker: takes a note posted from the game and files it as a GitHub issue.
// Deploy: see README.md in this folder. The GitHub token is a secret (`wrangler secret put GITHUB_TOKEN`), never in here.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "brackish-feedback",
  "main": "src/index.js",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "REPO": "brackishgames/brackish",
    // set to an issue number to collect crash reports as comments on one issue, instead of a new issue each
    "CRASH_ISSUE": ""
  },
  // five reports a minute from any one address is plenty for a person, and too few for a script
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
