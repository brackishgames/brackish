{
  "name": "brackish",
  "private": true,
  "type": "module",
  "description": "Tooling only: the game itself has no build step and no dependencies at runtime.",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "lint": "node tools/imports.mjs --check && node tools/lint.mjs",
    "imports": "node tools/imports.mjs",
    "check": "node tools/check.mjs",
    "shot": "node tools/shot.mjs",
    "specimens": "node tools/specimens.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:game": "node tests/game.mjs",
    "test": "npm run lint && npm run test:unit && npm run test:game"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "globals": "17.13.0"
  }
}
